<Page
  x:Class="YukiBox.Desktop.Views.AudioEnhancementView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:YukiBox.Desktop.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="using:YukiBox.Desktop.Helpers"
  xmlns:local="using:YukiBox.Desktop.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:YukiBox.Desktop.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:AudioEnhancementViewModel}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">

  <c:SettingsPageControl>
    <c:SettingsPageControl.ModuleContent>
      <StackPanel>
        <c:SettingsGroup Margin="0,-20,0,0" Header="{helpers:I18N Code='AudioEnhancement.Taskbar'}">
          <c:SettingExpander>
            <c:SettingExpander.Header>
              <c:Setting Description="{helpers:I18N Code='AudioEnhancement.Taskbar.WheelVolume.Desc'}" Header="{helpers:I18N Code='AudioEnhancement.Taskbar.WheelVolume'}">
                <c:Setting.ActionContent>
                  <ToggleSwitch
                    FontSize="14"
                    IsOn="{x:Bind ViewModel.EnableWheelVolume, Mode=TwoWay}"
                    OffContent="{helpers:I18N Code='ToggleButton.Off'}"
                    OnContent="{helpers:I18N Code='ToggleButton.On'}" />
                </c:Setting.ActionContent>
              </c:Setting>
            </c:SettingExpander.Header>
            <StackPanel>
              <c:Setting
                Description="{helpers:I18N Code='AudioEnhancement.Taskbar.WheelVolume.Adjust.Desc'}"
                Header="{helpers:I18N Code='AudioEnhancement.Taskbar.WheelVolume.Adjust'}"
                IsEnabled="{x:Bind ViewModel.EnableWheelVolume, Mode=OneWay}"
                Style="{StaticResource ExpanderContentSettingStyle}">
                <c:Setting.ActionContent>
                  <ToggleSwitch
                    FontSize="14"
                    IsOn="{x:Bind ViewModel.EnableWheelVolumeAdjust, Mode=TwoWay}"
                    OffContent="{helpers:I18N Code='ToggleButton.Off'}"
                    OnContent="{helpers:I18N Code='ToggleButton.On'}" />
                </c:Setting.ActionContent>
              </c:Setting>
              <c:Setting
                Description="{helpers:I18N Code='AudioEnhancement.Taskbar.WheelVolume.MiddleClickMute.Desc'}"
                Header="{helpers:I18N Code='AudioEnhancement.Taskbar.WheelVolume.MiddleClickMute'}"
                IsEnabled="{x:Bind ViewModel.EnableWheelVolume, Mode=OneWay}"
                Style="{StaticResource ExpanderContentSettingStyle}">
                <c:Setting.ActionContent>
                  <ToggleSwitch
                    FontSize="14"
                    IsOn="{x:Bind ViewModel.EnableWheelVolumeMiddleClickMute, Mode=TwoWay}"
                    OffContent="{helpers:I18N Code='ToggleButton.Off'}"
                    OnContent="{helpers:I18N Code='ToggleButton.On'}" />
                </c:Setting.ActionContent>
              </c:Setting>
              <c:Setting
                Description="{helpers:I18N Code='AudioEnhancement.Taskbar.WheelVolume.Reverse.Desc'}"
                Header="{helpers:I18N Code='AudioEnhancement.Taskbar.WheelVolume.Reverse'}"
                IsEnabled="{x:Bind ViewModel.EnableWheelVolume, Mode=OneWay}"
                Style="{StaticResource ExpanderContentSettingStyle}">
                <c:Setting.ActionContent>
                  <ToggleSwitch
                    FontSize="14"
                    IsOn="{x:Bind ViewModel.ReverseWheelVolume, Mode=TwoWay}"
                    OffContent="{helpers:I18N Code='ToggleButton.Off'}"
                    OnContent="{helpers:I18N Code='ToggleButton.On'}" />
                </c:Setting.ActionContent>
              </c:Setting>
            </StackPanel>
          </c:SettingExpander>
        </c:SettingsGroup>
      </StackPanel>
    </c:SettingsPageControl.ModuleContent>
  </c:SettingsPageControl>
</Page>
